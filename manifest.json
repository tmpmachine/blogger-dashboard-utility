{
  "name": "Blogger Dashboard Utility",
  "description": "Utilities for Blogger template developer and blog author.",
  "version": "1.2",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.blogger.com/blog/*",
        "https://*.blogger.com/u/*/blog/*"
      ],
      "js": [
        "post-editor-util.js",
        "inject-all-pages.js"
      ]
    },
    {
      "all_frames": true,
      "matches": [
        "*://*.blogger.com/display*",
        "*://*.blogger.com/u/*/display*"
      ],
      "css": [
        "style.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "codemirror-custom-shortcut.js" ],
      "matches": [
        "https://*.blogger.com/*"
      ]
    }
  ]
}